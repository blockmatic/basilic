{
  "extends": "fastify-tsconfig",
  "compilerOptions": {
    "outDir": "dist",
    "sourceMap": true,
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "target": "ES2022",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@repo/email/*": ["../../packages/email/*"],
      "@test/utils": ["./test/utils"]
    }
  },
  "include": ["server.ts", "src/**/*.ts", "api/**/*.ts"],
  "exclude": ["**/*.spec.ts", "**/*.test.ts"]
}
