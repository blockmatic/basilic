# TruffleHog exclude patterns
# These paths will be excluded from secret scanning
# Patterns are regex-based, one per line

# Documentation files (contain example connection strings)
^apps/docu/.*
^\.agents/skills/.*
^packages/.*/README\.md$

# Committed env templates and defaults (match scripts/block-secret-files.mjs allowlist)
.*\.env\.[^/]+\.example$
.*\.env\.schema$
.*\.env\.(development|staging|production|test)$

# Test files
.*\.test\.(ts|tsx|js|jsx|mjs)$
.*\.spec\.(ts|tsx|js|jsx|mjs)$
.*/(test|tests)/.*\.(ts|tsx|js|jsx|mjs)$
__tests__/.*
__mocks__/.*
fixtures/.*
examples/.*

# Build and dependency directories
node_modules/.*
\.next/.*
dist/.*
build/.*
\.turbo/.*
\.vercel/.*
\.pnp/.*
\.logs/.*
coverage/.*
test-results/.*
playwright-report/.*
playwright/\.cache/.*

# Lock files
pnpm-lock\.yaml$
package-lock\.json$
yarn\.lock$

# Git directory
\.git/.*

# Contract build outputs
contracts/evm/out/.*
contracts/evm/cache/.*
contracts/evm/broadcast/.*
contracts/solana/target/.*
contracts/solana/\.anchor/.*
