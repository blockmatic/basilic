{
  "name": "@repo/utils",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "Shared utility functions and helpers",
  "license": "PROPRIETARY",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./async": {
      "types": "./src/async/index.ts",
      "import": "./src/async/index.ts"
    },
    "./web3": {
      "types": "./src/web3/index.ts",
      "import": "./src/web3/index.ts"
    },
    "./logger": {
      "types": "./src/logger/index.ts",
      "browser": "./src/logger/client.ts",
      "node": "./src/logger/server.ts",
      "import": "./src/logger/server.ts",
      "default": "./src/logger/server.ts"
    },
    "./debug": {
      "types": "./src/debug/index.ts",
      "import": "./src/debug/index.ts"
    },
    "./error": {
      "types": "./src/error/index.ts",
      "import": "./src/error/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "checktypes": "tsgo --noEmit",
    "dev": "tsup --watch",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "prepack": "pnpm build && node ../../scripts/prepare-publish.mjs",
    "postpack": "node ../../scripts/restore-publish.mjs",
    "test": "echo \"no test\""
  },
  "peerDependencies": {
    "ahooks": "*",
    "nuqs": "*",
    "pino": "*",
    "react": "*",
    "typescript": "^5.0.0",
    "vconsole": "*",
    "viem": "*",
    "zod": "*",
    "zod-validation-error": "*"
  },
  "peerDependenciesMeta": {
    "ahooks": {
      "optional": true
    },
    "nuqs": {
      "optional": true
    },
    "pino": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vconsole": {
      "optional": true
    },
    "zod-validation-error": {
      "optional": true
    }
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/lodash-es": "latest",
    "@types/node": "*",
    "@types/react": "*",
    "eslint": "*",
    "ahooks": "^3.9.6",
    "lodash-es": "^4.17.23",
    "nuqs": "^2.8.6",
    "react": "^19.2.3",
    "tsup": "*",
    "@typescript/native-preview": "7.0.0-dev.20260124.1",
    "vconsole": "^3.15.1",
    "viem": "2.44.4",
    "zod": "^4.3.5",
    "zod-validation-error": "^5.0.0"
  }
}
