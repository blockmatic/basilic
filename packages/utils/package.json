{
  "name": "@repo/utils",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "Shared utility functions and helpers",
  "license": "PROPRIETARY",
  "exports": {
    "./async": {
      "types": "./src/async/index.ts",
      "import": "./dist/async/index.js"
    },
    "./error": {
      "types": "./src/error/index.ts",
      "import": "./dist/error/index.js"
    },
    "./web3": {
      "types": "./src/web3/index.ts",
      "import": "./dist/web3/index.js"
    },
    "./logger": {
      "types": "./src/logger/index.ts",
      "browser": "./dist/logger/client.js",
      "node": "./dist/logger/server.js",
      "import": "./dist/logger/server.js",
      "default": "./dist/logger/server.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "checktypes": "tsc --noEmit",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "prepack": "pnpm build && node ../../scripts/prepare-publish.mjs",
    "postpack": "node ../../scripts/restore-publish.mjs"
  },
  "peerDependencies": {
    "lodash-es": "*",
    "pino": "*",
    "typescript": "^5.0.0",
    "viem": "*",
    "zod": "*",
    "zod-validation-error": "*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/lodash-es": "latest",
    "@types/node": "^24.10.1",
    "eslint": "^9.32.0",
    "lodash-es": "latest",
    "tsup": "^8.3.5",
    "typescript": "^5.9.2",
    "viem": "2.44.1",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.3.0"
  }
}
