{
  "name": "@repo/notif",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": "./src/index.ts",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types/*": {
      "types": "./src/types/*.ts",
      "source": "./src/types/*.ts",
      "node": "./dist/types/*.js",
      "import": "./dist/types/*.js",
      "default": "./dist/types/*.js"
    },
    "./node": {
      "types": "./src/env.ts",
      "source": "./src/env.ts",
      "node": "./dist/env.js",
      "import": "./dist/env.js",
      "default": "./dist/env.js"
    }
  },
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "lint": "biome check .",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "format": "biome format --write .",
    "checktypes": "tsgo --noEmit",
    "build": "tsgo"
  },
  "dependencies": {
    "@repo/email": "workspace:*",
    "@repo/utils": "workspace:*",
    "nanoid": "^6.0.1",
    "resend": "^6.25.0",
    "zod": "^4.5.2"
  },
  "peerDependencies": {
    "@t3-oss/env-core": "^0.13.10"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^10.9.1",
    "react": "^19.2.8"
  }
}
