{
  "name": "@repo/email",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./emails/*": {
      "types": "./emails/*.tsx",
      "source": "./emails/*.tsx",
      "node": "./dist/emails/*.js",
      "import": "./dist/emails/*.js",
      "default": "./dist/emails/*.js"
    },
    "./render": {
      "types": "./render.ts",
      "source": "./render.ts",
      "node": "./dist/render.js",
      "import": "./dist/render.js",
      "default": "./dist/render.js"
    }
  },
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "lint": "biome check .",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "format": "biome format --write .",
    "checktypes": "tsgo --noEmit",
    "dev": "email dev -p 3003",
    "build": "tsgo",
    "build:preview": "NEXT_TELEMETRY_DISABLED=1 email build",
    "start": "email start"
  },
  "dependencies": {
    "@react-email/components": "1.0.7",
    "@react-email/render": "2.0.4",
    "@react-email/tailwind": "2.0.4",
    "@repo/ui": "workspace:*",
    "date-fns": "^4.1.0",
    "react-email": "5.2.8"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@react-email/preview-server": "5.2.8",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@typescript/native-preview": "7.0.0-dev.20260213.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.0",
    "react": "^19.2.4"
  }
}
