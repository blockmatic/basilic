{
  "name": "@repo/core",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "checktypes": "tsgo --noEmit",
    "dev": "node --import tsx scripts/wait-and-watch.mjs",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run lint:biome:fix",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check . --write",
    "prepack": "pnpm build && node ../../scripts/prepare-publish.mjs",
    "postpack": "node ../../scripts/restore-publish.mjs",
    "generate": "openapi-ts && node --import tsx scripts/generate-wrapper.mjs",
    "test": "echo \"no test\""
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.90.8",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/utils": "workspace:*",
    "chokidar-cli": "^3.0.0",
    "eslint": "*",
    "tsup": "*",
    "tsx": "^4.21.0",
    "@typescript/native-preview": "7.0.0-dev.20260124.1"
  }
}
