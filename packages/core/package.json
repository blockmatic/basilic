{
  "name": "@basilic/core",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "prepack": "pnpm build && node ../../scripts/prepare-publish.mjs",
    "postpack": "node ../../scripts/restore-publish.mjs"
  },
  "dependencies": {
    "@basilic/contracts": "workspace:*",
    "@ts-rest/core": "^3.51.0"
  },
  "devDependencies": {
    "@basilic/eslint-config": "workspace:*",
    "@basilic/typescript-config": "workspace:*",
    "eslint": "^9.39.2",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  }
}
