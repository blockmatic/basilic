{
  "name": "@repo/core",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup && tsc --declaration --emitDeclarationOnly",
    "checktypes": "tsc --noEmit",
    "dev": "node --import tsx scripts/wait-and-watch.mjs",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run lint:biome:fix",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check . --write",
    "prepack": "pnpm build && node ../../scripts/prepare-publish.mjs",
    "postpack": "node ../../scripts/restore-publish.mjs",
    "generate": "openapi-ts && node --import tsx scripts/generate-wrapper.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.0.0-next-20260824173136",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/utils": "workspace:*",
    "@typescript/native": "npm:typescript@^7.0.2",
    "chokidar-cli": "^3.0.0",
    "eslint": "^10.9.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11"
  }
}
