{
  "name": "@repo/react",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "checktypes": "tsgo --noEmit",
    "dev": "tsup --watch",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check . --write",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run lint:biome:fix",
    "prepack": "pnpm build && node ../../scripts/prepare-publish.mjs",
    "postpack": "node ../../scripts/restore-publish.mjs",
    "test": "pnpm test:unit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@repo/ui": "workspace:*",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/utils": "workspace:*",
    "@tanstack/react-query": "^5.90.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "*",
    "eslint": "*",
    "jsdom": "^27.4.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsup": "*",
    "vitest": "*",
    "@typescript/native-preview": "7.0.0-dev.20260124.1"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.17",
    "react": "^19.0.0"
  }
}
