{
  "name": "@repo/react",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup && tsc --declaration --emitDeclarationOnly",
    "checktypes": "tsc --noEmit",
    "dev": "tsup --watch",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check . --write",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run lint:biome:fix",
    "prepack": "pnpm build && node ../../scripts/prepare-publish.mjs",
    "postpack": "node ../../scripts/restore-publish.mjs",
    "test": "pnpm test:unit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.87",
    "@repo/core": "workspace:*",
    "@repo/ui": "workspace:*",
    "@simplewebauthn/browser": "^13.3.0",
    "ai": "^7.0.84",
    "jose": "^6.2.10",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/utils": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.17",
    "react": "^19.0.0"
  }
}
