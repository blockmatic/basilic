{
  "name": "@repo/cli",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript CLI to interact with Basilic Fastify API via API key",
  "bin": {
    "basilic": "./dist/cli.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/cli.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "checktypes": "tsc --noEmit",
    "generate": "node --import tsx scripts/generate-cli.mjs"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "~26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
