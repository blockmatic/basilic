{
  "name": "@repo/error",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "Error reporting and utilities",
  "license": "PROPRIETARY",
  "exports": {
    ".": {
      "types": "./src/utils/index.ts",
      "source": "./src/utils/index.ts",
      "import": "./dist/index.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./src/node/index.ts",
      "source": "./src/node/index.ts",
      "import": "./dist/node.js",
      "node": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./nextjs": {
      "types": "./src/nextjs/index.ts",
      "source": "./src/nextjs/index.ts",
      "import": "./dist/nextjs.js",
      "node": "./dist/nextjs.js",
      "default": "./dist/nextjs.js"
    },
    "./nextjs/server": {
      "types": "./src/nextjs/server.ts",
      "source": "./src/nextjs/server.ts",
      "import": "./dist/nextjs-server.js",
      "node": "./dist/nextjs-server.js",
      "default": "./dist/nextjs-server.js"
    },
    "./browser": {
      "types": "./src/browser/index.ts",
      "source": "./src/browser/index.ts",
      "import": "./dist/browser.js"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "source": "./src/react/index.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc --declaration --emitDeclarationOnly",
    "checktypes": "tsc --noEmit",
    "dev": "tsup --watch",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:types": "tsc --noEmit src/__tests__/types.test-d.ts",
    "prepack": "pnpm build && node ../../scripts/prepare-publish.mjs",
    "postpack": "node ../../scripts/restore-publish.mjs"
  },
  "dependencies": {
    "@repo/utils": "workspace:*"
  },
  "peerDependencies": {
    "@repo/utils": "workspace:*",
    "@sentry/browser": "^10.34.0",
    "@sentry/nextjs": "^10.34.0",
    "@sentry/node": "^10.34.0",
    "pino": "*",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@sentry/node": {
      "optional": true
    },
    "@sentry/nextjs": {
      "optional": true
    },
    "@sentry/browser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@sentry/browser": "^10.72.0",
    "@sentry/nextjs": "^10.72.0",
    "@sentry/node": "^10.72.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.9.1",
    "react": "^19.2.8",
    "tsup": "^8.5.1",
    "vitest": "^4.1.11"
  }
}
