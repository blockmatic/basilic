{
  "name": "@repo/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Drizzle PostgreSQL schema, client factory, and named data-access functions",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "import": "./dist/schema/index.js",
      "node": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    },
    "./migrate": {
      "types": "./src/migrate.ts",
      "import": "./dist/migrate.js",
      "node": "./dist/migrate.js",
      "default": "./dist/migrate.js"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/copy-migrations.mjs",
    "checktypes": "tsc --noEmit",
    "dev": "tsc --watch",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run",
    "db:generate": "NODE_OPTIONS='--import tsx' drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:start": "node scripts/start-postgres.mjs",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "prepack": "pnpm build && node ../../scripts/prepare-publish.mjs",
    "postpack": "node ../../scripts/restore-publish.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "vitest": "^5.0.1"
  }
}
