{
  "mcpServers": {
    "shadcn": {
      "command": "pnpm",
      "args": ["dlx", "@shadcn/mcp"]
    },
    "v0": {
      "command": "pnpm",
      "args": ["dlx", "@modelcontextprotocol/server-v0"],
      "env": {
        "V0_API_KEY": "${V0_API_KEY}"
      }
    },
    "github": {
      "command": "pnpm",
      "args": ["dlx", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "vercel": {
      "command": "pnpm",
      "args": ["dlx", "@modelcontextprotocol/server-vercel"],
      "env": {
        "VERCEL_API_TOKEN": "${VERCEL_API_TOKEN}"
      }
    }
  }
}
