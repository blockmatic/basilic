{
  "mcpServers": {
    "shadcn": {
      "command": "pnpm",
      "args": ["dlx", "@shadcn/mcp"]
    },
    "v0": {
      "command": "pnpm",
      "args": ["dlx", "@modelcontextprotocol/server-v0"],
      "env": {
        "V0_API_KEY": "${V0_API_KEY}"
      }
    },
    "github": {
      "command": "pnpm",
      "args": ["dlx", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "vercel-docs": {
      "url": "https://mcp.vercel.com/gaboesquivel/basilic-docs",
      "description": "Vercel MCP for @basilic/docs"
    },
    "vercel-api": {
      "url": "https://mcp.vercel.comgaboesquivel/basilic-api",
      "description": "Vercel MCP for @basilic/api"
    }
  }
}
