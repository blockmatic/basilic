{
  "name": "@repo/next",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:local": "NODE_ENV=development next dev --webpack",
    "dev:staging": "NODE_ENV=development NEXT_PUBLIC_APP_ENV=staging next dev --webpack",
    "build": "NODE_ENV=production next build --webpack",
    "build:validate": "NODE_ENV=production next build --webpack",
    "start": "next start",
    "build:e2e": "NEXT_PUBLIC_API_URL=http://localhost:3001 next build --webpack",
    "start:e2e": "NEXT_PUBLIC_API_URL=http://localhost:3001 next build --webpack && NODE_ENV=test next start",
    "start:e2e:server": "NODE_ENV=test next start",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check . --write",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run lint:biome:fix",
    "format": "biome format . --write",
    "checktypes": "tsgo --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:cov": "vitest run --coverage",
    "test:e2e": "node ../../scripts/run-next-e2e.mjs",
    "test:e2e:reuse": "playwright test",
    "start:e2e:servers": "node scripts/start-e2e-servers.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@lukemorales/query-key-factory": "^1.3.4",
    "@repo/core": "workspace:*",
    "@repo/react": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/utils": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-query": "^5.90.21",
    "@vercel/analytics": "1.6.1",
    "ai-elements": "^1.8.4",
    "autoprefixer": "^10.4.24",
    "import-in-the-middle": "^3.0.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.564.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.1",
    "react-markdown": "^10.1.0",
    "require-in-the-middle": "^8.0.1",
    "use-stick-to-bottom": "^1.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260213.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "browserslist": "^4.28.1",
    "eslint": "^9.0.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.6",
    "vitest": "^4.0.18"
  }
}
