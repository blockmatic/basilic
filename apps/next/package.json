{
  "name": "@repo/next",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:local": "NODE_ENV=development next dev --webpack",
    "dev:staging": "NODE_ENV=development NEXT_PUBLIC_APP_ENV=staging next dev --webpack",
    "build": "NODE_ENV=production next build --webpack",
    "build:validate": "NODE_ENV=production next build --webpack",
    "start": "next start",
    "start:e2e": "NEXT_PUBLIC_API_URL=http://localhost:3001 next build --webpack && NODE_ENV=test next start",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check . --write",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run lint:biome:fix",
    "format": "biome format . --write",
    "checktypes": "tsgo --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@lukemorales/query-key-factory": "^1.3.4",
    "@repo/core": "workspace:*",
    "@repo/react": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/utils": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-query": "^5.90.19",
    "@vercel/analytics": "1.6.1",
    "ai-elements": "^1.8.4",
    "autoprefixer": "^10.4.23",
    "import-in-the-middle": "^2.0.5",
    "jose": "^6.0.0",
    "lucide-react": "^0.562.0",
    "next": "16.1.5",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-error-boundary": "^6.1.0",
    "react-markdown": "^10.1.0",
    "require-in-the-middle": "^8.0.1",
    "use-stick-to-bottom": "^1.1.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260124.1",
    "@vitest/coverage-v8": "*",
    "@vitest/ui": "^4.0.17",
    "browserslist": "^4.28.1",
    "eslint": "*",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "vitest": "*"
  }
}
