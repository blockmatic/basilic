{
  "name": "@repo/mobile",
  "type": "module",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "expo start",
    "start:localhost": "expo start --localhost",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "checktypes": "tsc --noEmit",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check . --write",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run lint:biome:fix",
    "test:e2e": "maestro test .maestro/flows/home.yml"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/elements": "^2.9.43",
    "@react-navigation/native": "^7.4.1",
    "@repo/ui": "workspace:*",
    "clsx": "^2.1.1",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "nativewind": "5.0.0-preview.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.87.1",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "~4.28.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "~26.6.2",
    "@types/react": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-plugin-react-compiler": "19.0.0-beta-af1b7da-20250417",
    "eslint": "^10.11.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "private": true
}
