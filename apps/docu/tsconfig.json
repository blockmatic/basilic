{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "*": ["./*"],
      "@/*": ["./*"],
      "@/components/*": ["./components/*"],
      "@repo/ui/*": ["../../packages/ui/src/*"],
      "fumadocs-mdx:collections/*": ["./.source/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "skipLibCheck": true
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "types/**/*.d.ts",
    "../../config/typescript/reset.d.ts"
  ],
  "exclude": ["node_modules"]
}
