{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "npx turbo-ignore @repo/docu --fallback=HEAD~10",
  "buildCommand": "cd ../.. && npx pnpm turbo build --filter=@repo/docu...",
  "installCommand": "cd ../.. && npx pnpm install",
  "devCommand": "cd ../.. && npx pnpm dev --filter=@repo/docu",
  "outputDirectory": ".next",
  "framework": "nextjs"
}
