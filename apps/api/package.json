{
  "type": "module",
  "name": "@repo/api",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "engines": {
    "node": ">=22"
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run build:ts && tsc -p test/tsconfig.json && FASTIFY_AUTOLOAD_TYPESCRIPT=1 node --test --experimental-test-coverage --loader ts-node/esm test/**/*.ts",
    "start": "npm run build:ts && fastify start -l info dist/app.js",
    "build": "tsc",
    "build:ts": "tsc",
    "watch:ts": "tsc -w",
    "dev": "tsx watch src/index.ts",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "checktypes": "tsc --noEmit",
    "generate:openapi": "tsx scripts/generate-openapi.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.6.1",
    "@scalar/fastify-api-reference": "^1.43.4",
    "@t3-oss/env-core": "^0.13.10",
    "fastify": "^5.6.2",
    "fastify-cli": "^7.4.1",
    "fastify-plugin": "^5.1.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/node": "^25.0.8",
    "c8": "^10.1.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "fastify-tsconfig": "^3.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
