{
  "type": "module",
  "name": "@basilic/api",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "engines": {
    "node": ">=22"
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run build:ts && tsc -p test/tsconfig.json && FASTIFY_AUTOLOAD_TYPESCRIPT=1 node --test --experimental-test-coverage --loader ts-node/esm test/**/*.ts",
    "start": "npm run build:ts && fastify start -l info dist/app.js",
    "build": "tsc",
    "build:ts": "tsc",
    "watch:ts": "tsc -w",
    "dev": "tsx watch src/index.ts",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@basilic/contracts": "workspace:*",
    "@scalar/fastify-api-reference": "^1.0.0",
    "@ts-rest/fastify": "^3.51.0",
    "@ts-rest/open-api": "^3.51.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "@fastify/autoload": "^6.0.0",
    "@fastify/sensible": "^6.0.0",
    "fastify-cli": "^7.4.1"
  },
  "devDependencies": {
    "@basilic/eslint-config": "workspace:*",
    "@types/node": "^24.0.8",
    "c8": "^10.1.2",
    "eslint": "^9.39.2",
    "ts-node": "^10.4.0",
    "concurrently": "^9.0.0",
    "fastify-tsconfig": "^3.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  }
}
