{
  "type": "module",
  "name": "@repo/api",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "dist/server.js",
  "engines": {
    "node": "24.x"
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "pnpm test:unit",
    "test:unit": "node scripts/check-test-imports.mjs && NODE_OPTIONS='--import tsx' vitest run",
    "test:watch": "NODE_OPTIONS='--import tsx' vitest",
    "test:cov": "NODE_OPTIONS='--import tsx' vitest run --coverage",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:local": "node scripts/run-e2e-local.mjs",
    "test:e2e:ui": "pnpm test:e2e -- --ui",
    "test:e2e:debug": "pnpm test:e2e -- --debug",
    "start": "pnpm build && node dist/server.js",
    "start:ci": "NODE_ENV=test ALLOW_TEST=true node --import tsx server.ts",
    "build": "pnpm generate:openapi && pnpm build:ts",
    "build:ts": "tsc -p tsconfig.build.json",
    "watch:ts": "pnpm build:ts && concurrently 'tsc -p tsconfig.build.json -w'",
    "dev": "pnpm generate:openapi && concurrently -n server,openapi 'node --watch --import tsx server.ts' 'chokidar \"src/routes/**/*.ts\" \"src/plugins/**/*.ts\" -c \"pnpm generate:openapi\"'",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check . --write",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run lint:biome:fix",
    "checktypes": "tsc --noEmit -p tsconfig.build.json",
    "generate:openapi": "node --import tsx scripts/generate-openapi.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "reset": "supabase db reset && RUN_PG_MIGRATE=true DATABASE_URL=\"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" sh -c 'pnpm db:migrate && node --import tsx scripts/seed.ts'",
    "db:status": "supabase status",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:generate": "NODE_OPTIONS='--import tsx' drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.45",
    "@faker-js/faker": "^10.6.0",
    "@fastify/autoload": "^6.5.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@repo/email": "workspace:*",
    "@repo/error": "workspace:*",
    "@repo/utils": "workspace:*",
    "@scalar/fastify-api-reference": "^1.67.0",
    "@sentry/node": "^10.72.0",
    "@simplewebauthn/server": "^13.3.3",
    "@sinclair/typebox": "^0.34.52",
    "@solana/web3.js": "^1.98.4",
    "@t3-oss/env-core": "^0.13.11",
    "ai": "^7.0.84",
    "ai-sdk-ollama": "^4.2.0",
    "bs58": "^6.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^6.0.0",
    "google-auth-library": "^11.0.2",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "resend": "^6.25.0",
    "siwe": "^3.0.0",
    "tweetnacl": "^1.0.3",
    "viem": "^2.56.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.62.1",
    "@repo/eslint-config": "workspace:*",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "fastify-tsconfig": "^3.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "undici-types": "^8.10.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
