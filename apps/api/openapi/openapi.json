  "paths": {
    "/health": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Returns server health status with current ISO datetime",
        "tags": ["health"],
        "description": "Health check endpoint",
        "responses": {
          "200": {
            "description": "Health check response",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Health check response",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "now": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": ["ok", "now"]
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/example/": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    }
  }
