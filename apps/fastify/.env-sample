OPENAI_API_KEY=sk-proj-1234567890

# Database configuration
# Set PGLITE=true to use in-memory PGLite database (useful for preview branches, local dev without PostgreSQL)
# When PGLITE=true, DATABASE_URL is optional and defaults to PGLite URL
# When PGLITE=false, DATABASE_URL is required
PGLITE=false
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=App
# Set USE_FAKE_EMAIL=true to use fake email provider (emails won't be sent, stored in memory for testing)
USE_FAKE_EMAIL=false

# JWT configuration
JWT_SECRET=your-32-character-minimum-secret-key-here