# Test env - copy to .env.test (gitignored)
NODE_ENV=test
PGLITE=true
DATABASE_URL=postgresql://localhost/test
JWT_SECRET=e2e-jwt-secret-min-32-chars-for-tests

# AI provider: AI tests use Ollama at ollama.gaboesquivel.com by default (override in vitest.setup.ts if needed)
# Local Ollama: OLLAMA_BASE_URL=http://localhost:11434
# Open Router: OPEN_ROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxx (optional; AI tests unset it)
OLLAMA_BASE_URL=https://ollama.gaboesquivel.com

# Optional: Override default AI model
# AI_DEFAULT_MODEL=qwen2.5:3b

# Optional: GitHub OAuth (for OAuth route tests)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_GITHUB_CALLBACK_URL=http://localhost:3000/auth/callback/oauth/github

# CORS + URL allowlist. Default: * (any). Comma-separated origins to restrict.
# ALLOWED_ORIGINS=https://app.example.com,https://localhost:3000
