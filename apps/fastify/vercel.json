{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastify",
  "buildCommand": "cd ../.. && pnpm install && pnpm turbo build --filter=@repo/fastify",
  "installCommand": "cd ../.. && pnpm install",
  "functions": {
    "api/[...].ts": {
      "maxDuration": 30,
      "excludeFiles": "{server.ts,server.js,src/app.ts,dist/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/$1"
    }
  ]
}
