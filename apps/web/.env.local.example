# Local secrets and overrides — copy to .env.local (gitignored).
# Committed defaults live in .env.development / .env.staging / .env.production.
# Schema: apps/web/lib/env.ts

# -----------------------------------------------------------------------------
# Client (NEXT_PUBLIC_* — exposed to the browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.basilic.localhost
# Canonical public origin (sitemap loc, robots Sitemap). Defaults to https://basilic.localhost; Vercel falls back to VERCEL_URL.
# NEXT_PUBLIC_APP_URL=https://basilic.localhost
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# Optional Reown/WalletConnect Cloud project id. Unset hides WalletConnect-only rows.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# NEXT_PUBLIC_AUTH_COOKIE_NAME=api.session
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# NEXT_PUBLIC_LOG_ENABLED=true
# parseBool: 1, true, yes, on (not Zod coerce — the string "false" is false)
# NEXT_PUBLIC_LOG_LEVEL=debug
# NEXT_PUBLIC_LEGAL_EMAIL=legal@example.com

# -----------------------------------------------------------------------------
# Server-only (Next server; not prefixed — never expose to client code)
# -----------------------------------------------------------------------------
JWT_SECRET=default-jwt-secret-min-32-chars-for-dev
# Must match apps/api JWT_ISSUER / JWT_AUDIENCE (proxy verifies HS256 + iss/aud)
# JWT_ISSUER=api.yourapp.com
# JWT_AUDIENCE=api.yourapp.com
# AUTH_COOKIE_NAME=api.session
# Local Product Ready: test@test.ai without Resend. Production must not set this.
ALLOW_TEST=true
# Optional Jev composeSpec on Commands Send (server-only; never NEXT_PUBLIC_*).
# Unset skips to composeSurface. Independent from the eve host key.
# AI_GATEWAY_API_KEY=
# JEV_MODEL=typesafe-ai/jev
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=

# -----------------------------------------------------------------------------
# E2E / Playwright only (not in createEnv — scripts read process.env directly)
# -----------------------------------------------------------------------------
# Playwright against a running `pnpm dev` (Portless):
# PLAYWRIGHT_APP_URL=https://basilic.localhost
# PLAYWRIGHT_API_URL=https://api.basilic.localhost
# `test:e2e:local` / CI spawn loopback ports 3000/3001 instead.
# VERCEL_AUTOMATION_BYPASS_SECRET=
