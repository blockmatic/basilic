# Production Environment Configuration
# This file is committed - contains non-sensitive configuration only

# API URL - required for production builds
# NOTE: This must be set to the real production API endpoint at deployment time
# CI/CD validation will fail if this matches the placeholder
NEXT_PUBLIC_API_URL=https://api.basilic.dev

# Optional: Sentry error tracking
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
