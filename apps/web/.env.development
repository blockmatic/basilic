# Development — committed, non-sensitive defaults only.
# Secrets: use .env.local (see .env.local.example).

# -----------------------------------------------------------------------------
# Client (NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.basilic.localhost
NEXT_PUBLIC_APP_URL=https://basilic.localhost

# Google One Tap — optional. Unconfigured OAuth returns 503.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# Optional WalletConnect project id. Unset keeps injected/Standard wallets only.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

NEXT_PUBLIC_LOG_ENABLED=true
NEXT_PUBLIC_LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
