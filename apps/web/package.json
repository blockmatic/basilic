{
  "name": "@repo/web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:local": "NODE_ENV=development next dev --webpack",
    "dev:staging": "NODE_ENV=development NEXT_PUBLIC_APP_ENV=staging next dev --webpack",
    "build": "NODE_ENV=production next build --webpack",
    "build:validate": "NODE_ENV=production next build --webpack",
    "start": "next start",
    "build:e2e": "NEXT_PUBLIC_API_URL=http://localhost:3001 next build --webpack",
    "start:e2e": "NEXT_PUBLIC_API_URL=http://localhost:3001 next build --webpack && NODE_ENV=test next start",
    "start:e2e:server": "NODE_ENV=test next start",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check . --write",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run lint:biome:fix",
    "format": "biome format . --write",
    "checktypes": "node ../../node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:local": "node scripts/run-e2e-local.mjs",
    "test:e2e:ui": "pnpm test:e2e -- --ui",
    "test:e2e:debug": "pnpm test:e2e -- --debug",
    "start:e2e:servers": "node scripts/start-e2e-servers.mjs"
  },
  "dependencies": {
    "@json-render/core": "^0.21.0",
    "@json-render/react": "^0.21.0",
    "@repo/core": "workspace:*",
    "@repo/error": "workspace:*",
    "@repo/react": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/utils": "workspace:*",
    "@sentry/nextjs": "^10.75.0",
    "@solana/wallet-standard-features": "^1.5.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.103.1",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "@walletconnect/ethereum-provider": "^2.25.0",
    "@web3icons/react": "^4.1.22",
    "ahooks": "^3.10.0",
    "autoprefixer": "^10.6.1",
    "bs58": "^6.0.0",
    "import-in-the-middle": "^3.5.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.5",
    "react-markdown": "^10.1.0",
    "require-in-the-middle": "^8.0.1",
    "sonner": "^2.0.8",
    "use-stick-to-bottom": "^1.1.6",
    "viem": "2.56.5",
    "wagmi": "^3.7.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "~1.62.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bs58": "^5.0.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "browserslist": "^4.29.0",
    "eslint": "^10.10.0",
    "postcss": "^8.5.28",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  }
}
