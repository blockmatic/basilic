{
  "name": "@basilic/web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "NODE_ENV=development next dev",
    "dev:staging": "NODE_ENV=development NEXT_PUBLIC_APP_ENV=staging next dev",
    "build": "NODE_ENV=production next build",
    "build:validate": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check . --write",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run lint:biome:fix",
    "format": "biome format . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:cov": "vitest run --coverage",
    "_test:e2e": "playwright test",
    "_test:e2e:ui": "playwright test --ui",
    "_test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@basilic/react": "workspace:*",
    "@basilic/ui": "workspace:*",
    "@basilic/types": "workspace:*",
    "@sentry/nextjs": "^8.55.0",
    "@tanstack/react-query": "^5.67.0",
    "@vercel/analytics": "1.3.1",
    "autoprefixer": "^10.4.23",
    "import-in-the-middle": "^1.15.0",
    "lucide-react": "^0.475.0",
    "next": "16.0.7",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-error-boundary": "^4.1.2",
    "require-in-the-middle": "^7.5.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.5",
    "@t3-oss/env-nextjs": "^0.13.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "@basilic/eslint-config": "workspace:*",
    "@basilic/typescript-config": "workspace:*",
    "browserslist": "^4.28.1",
    "eslint": "^9.39.2",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
