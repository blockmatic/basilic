# Copy to .env and adjust. Placeholders only — never commit real secrets.
# Schema: apps/agents/lib/env.ts (t3 createEnv)

# -----------------------------------------------------------------------------
# Database (host only — never copy into sandbox)
# PGLITE=true uses in-memory DB; else DATABASE_URL (local Postgres) is required
# -----------------------------------------------------------------------------
PGLITE=false
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# -----------------------------------------------------------------------------
# JWT (same names as Fastify; do not invent EVE_JWT_*)
# -----------------------------------------------------------------------------
# JWT_SECRET=default-jwt-secret-min-32-chars-for-dev
# JWT_ISSUER=api.yourapp.com
# JWT_AUDIENCE=api.yourapp.com

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Markets (host tools; not sandbox)
# -----------------------------------------------------------------------------
# COINGECKO_DEMO_API_KEY=
# COINS_USE_FIXTURE=false
# MARKETS_CACHE_MS=300000

# -----------------------------------------------------------------------------
# On-chain (host tools; not sandbox)
# -----------------------------------------------------------------------------
# ALCHEMY_API_KEY=

# -----------------------------------------------------------------------------
# Model (Jev on Vercel AI Gateway — T4g; command language model — G-cmd)
# -----------------------------------------------------------------------------
# AI_GATEWAY_API_KEY=
# JEV_MODEL=typesafe-ai/jev
# AI_EVALUATE_TIMEOUT_MS=8000
# JEV_CANNED_MIN_PROBABILITY=0.8
# JEV_REFUSE_MIN_PROBABILITY=0.8
# AI_PROVIDER=
# ANTHROPIC_API_KEY=
# OPEN_ROUTER_API_KEY=
# OLLAMA_BASE_URL=
# AI_DEFAULT_MODEL=
# EVE_RATE_LIMIT_MAX=20
# EVE_RATE_LIMIT_WINDOW_MS=60000
