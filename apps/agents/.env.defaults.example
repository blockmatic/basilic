# Copy to .env and adjust. Placeholders only — never commit real secrets.
# Schema: apps/agents/lib/env.ts (t3 createEnv)

# -----------------------------------------------------------------------------
# Database (host only — never copy into sandbox)
# PGLITE=true uses in-memory DB; else POSTGRES_URL (local Postgres) is required
# -----------------------------------------------------------------------------
PGLITE=false
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# -----------------------------------------------------------------------------
# JWT (same names as Fastify; do not invent EVE_JWT_*)
# -----------------------------------------------------------------------------
# JWT_SECRET=default-jwt-secret-min-32-chars-for-dev
# JWT_ISSUER=api.yourapp.com
# JWT_AUDIENCE=api.yourapp.com
# AGENT_JWT_AUDIENCE=agents.yourapp.com

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# ALLOWED_ORIGINS=https://basilic.localhost

# -----------------------------------------------------------------------------
# Local workspace proxy (scripts/dev-workspace.mjs; not createEnv)
# Public mounts stay https://agents.basilic.localhost/eve/operator and /eve/ask
# -----------------------------------------------------------------------------
# EVE_OPERATOR_INTERNAL_PORT=3104
# EVE_ASK_INTERNAL_PORT=3105

# -----------------------------------------------------------------------------
# Model (Vercel AI Gateway — command language model)
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# AI_GATEWAY_API_KEY=  # Jev evaluate on operator only
# JEV_MODEL=typesafe-ai/jev
# AI_EVALUATE_TIMEOUT_MS=8000
# JEV_CANNED_MIN_PROBABILITY=0.8
# JEV_REFUSE_MIN_PROBABILITY=0.8
# AI_DEFAULT_MODEL=anthropic/claude-haiku-4.5
# EVE_RATE_LIMIT_MAX=20
# EVE_RATE_LIMIT_WINDOW_MS=60000
