{
  "name": "@repo/agents",
  "version": "0.0.0",
  "private": true,
  "portless": {
    "name": "agents.basilic",
    "script": "dev:app"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#lib/*": "./lib/*"
  },
  "scripts": {
    "checktypes": "tsc --noEmit",
    "dev": "portless",
    "dev:app": "node scripts/dev-workspace.mjs",
    "eve:build": "eve build",
    "eve:dev": "pnpm run dev",
    "eve:dev:command:app": "eve dev --agent command --no-ui",
    "eve:dev:chat": "eve dev --agent chat --no-ui",
    "eve:dev:chat:app": "eve dev --agent chat --no-ui",
    "eve:start": "eve start --port 3004",
    "eve:eval": "eve eval --agent command",
    "eve:eval:chat": "eve eval --agent chat",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:unit": "vitest run && node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.58",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@repo/db": "workspace:*",
    "@repo/markets": "workspace:*",
    "@repo/onchain": "workspace:*",
    "@repo/utils": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "@vercel/connect": "2.3.0",
    "ai": "^7.0.107",
    "ai-sdk-ollama": "^4.3.0",
    "dotenv": "^18.0.1",
    "eve": "^0.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/node": "~26.6.2",
    "eslint": "^10.11.0",
    "microsandbox": "^0.7.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  }
}
