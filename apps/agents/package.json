{
  "name": "@repo/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#lib/*": "./lib/*"
  },
  "scripts": {
    "checktypes": "tsc --noEmit",
    "dev": "eve dev --agent command --port 3004 --no-ui",
    "eve:build": "eve build",
    "eve:dev": "pnpm run dev",
    "eve:dev:chat": "eve dev --agent chat --port 3005 --no-ui",
    "eve:start": "eve start --port 3004",
    "eve:eval": "eve eval --agent command",
    "eve:eval:chat": "eve eval --agent chat",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.54",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@repo/db": "workspace:*",
    "@repo/markets": "workspace:*",
    "@repo/onchain": "workspace:*",
    "@repo/utils": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "@vercel/connect": "2.2.0",
    "ai": "^7.0.107",
    "ai-sdk-ollama": "^4.3.0",
    "dotenv": "^17.4.2",
    "eve": "^0.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/node": "^24.13.5",
    "eslint": "^10.10.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  }
}
