{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "generate": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "../../apps/fastify/openapi/openapi.json"],
      "outputs": ["src/gen/**"],
      "env": ["NODE_ENV"]
    },
    "@repo/fastify#generate:openapi": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "src/**/*.ts"],
      "outputs": ["openapi/openapi.json"],
      "env": ["NODE_ENV"]
    },
    "@repo/core#generate": {
      "dependsOn": ["@repo/fastify#generate:openapi"],
      "inputs": ["$TURBO_DEFAULT$", "../../apps/fastify/openapi/openapi.json"],
      "outputs": ["src/gen/**"],
      "env": ["NODE_ENV"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".react-email/**"],
      "env": [
        "NODE_ENV",
        "NEXT_RUNTIME",
        "PORT",
        "HOST",
        "DATABASE_URL",
        "PGLITE",
        "REDIS_URL",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "SENTRY_TRACES_SAMPLE_RATE",
        "SENTRY_REPLACES_HEADERS",
        "SENTRY_REPLACES_PROD_ENV",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_ENVIRONMENT",
        "NEXT_PUBLIC_SITE_URL",
        "LOG_ENABLED",
        "LOG_LEVEL",
        "LOG_SERVICE",
        "VERCEL_ENV",
        "NEXT_PUBLIC_LOG_ENABLED",
        "NEXT_PUBLIC_LOG_LEVEL",
        "OPENAI_API_KEY",
        "JWT_SECRET",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "APP_URL",
        "EMAIL_ASSETS_URL",
        "ENCRYPTION_KEY"
      ]
    },
    "lint": {},
    "lint:eslint": {
      "env": [
        "NODE_ENV",
        "NEXT_RUNTIME",
        "CI",
        "PLAYWRIGHT_TEST_BASE_URL",
        "PLAYWRIGHT_API_URL",
        "PORT",
        "DATABASE_URL",
        "PGLITE",
        "OPENAI_API_KEY",
        "ENCRYPTION_KEY",
        "VERCEL",
        "VERCEL_GIT_COMMIT_REF",
        "APP_URL",
        "EMAIL_ASSETS_URL",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "EMAIL_FROM_NAME",
        "USE_FAKE_EMAIL"
      ]
    },
    "lint:eslint:fix": {
      "cache": false,
      "env": [
        "NODE_ENV",
        "NEXT_RUNTIME",
        "CI",
        "PLAYWRIGHT_TEST_BASE_URL",
        "PLAYWRIGHT_API_URL",
        "PLAYWRIGHT_HTML_REPORT_OPEN",
        "PORT",
        "DATABASE_URL",
        "PGLITE",
        "OPENAI_API_KEY",
        "ENCRYPTION_KEY",
        "VERCEL",
        "VERCEL_URL",
        "VERCEL_GIT_COMMIT_REF",
        "APP_URL",
        "EMAIL_ASSETS_URL",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "EMAIL_FROM_NAME",
        "USE_FAKE_EMAIL"
      ]
    },
    "checktypes": {
      "env": ["NODE_ENV", "RESEND_API_KEY", "EMAIL_FROM", "EMAIL_FROM_NAME"]
    },
    "test": {
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "PGLITE",
        "OPENAI_API_KEY",
        "ENCRYPTION_KEY",
        "JWT_SECRET",
        "CI",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "EMAIL_FROM_NAME",
        "VITEST_WORKER_ID",
        "USE_FAKE_EMAIL"
      ]
    },
    "@repo/next#test": {
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "PGLITE",
        "OPENAI_API_KEY",
        "ENCRYPTION_KEY",
        "JWT_SECRET",
        "CI",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "EMAIL_FROM_NAME",
        "VITEST_WORKER_ID",
        "USE_FAKE_EMAIL"
      ]
    },
    "test:unit": {
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "PGLITE",
        "OPENAI_API_KEY",
        "ENCRYPTION_KEY",
        "JWT_SECRET",
        "CI",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "EMAIL_FROM_NAME",
        "VITEST_WORKER_ID",
        "USE_FAKE_EMAIL"
      ]
    },
    "test:e2e": {
      "env": [
        "NODE_ENV",
        "CI",
        "PLAYWRIGHT_TEST_BASE_URL",
        "PLAYWRIGHT_HTML_REPORT_OPEN",
        "PORT",
        "HOST",
        "DATABASE_URL",
        "PGLITE",
        "OPENAI_API_KEY",
        "ENCRYPTION_KEY",
        "JWT_SECRET",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "EMAIL_FROM_NAME",
        "NEXT_PUBLIC_API_URL"
      ]
    },
    "dev": {
      "dependsOn": [],
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "NEXT_RUNTIME",
        "PORT",
        "HOST",
        "DATABASE_URL",
        "PGLITE",
        "REDIS_URL",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_ENVIRONMENT",
        "NEXT_PUBLIC_SITE_URL",
        "LOG_ENABLED",
        "LOG_LEVEL",
        "LOG_SERVICE",
        "VERCEL_ENV",
        "NEXT_PUBLIC_LOG_ENABLED",
        "NEXT_PUBLIC_LOG_LEVEL",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "EMAIL_FROM_NAME"
      ]
    }
  }
}
