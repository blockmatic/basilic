{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["QA_SKIP_TESTS", "SKIP_KILL_PORTS"],
  "tasks": {
    "generate": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "../../apps/api/openapi/openapi.json"],
      "outputs": ["src/gen/**"],
      "env": ["NODE_ENV"]
    },
    "@repo/api#generate:openapi": {
      "dependsOn": ["@repo/utils#build", "@repo/error#build"],
      "inputs": ["$TURBO_DEFAULT$", "src/**/*.ts"],
      "outputs": ["openapi/openapi.json"],
      "env": [
        "NODE_ENV",
        "ANTHROPIC_API_KEY",
        "OLLAMA_BASE_URL",
        "OPEN_ROUTER_API_KEY",
        "AI_PROVIDER"
      ]
    },
    "@repo/core#generate": {
      "dependsOn": ["@repo/api#generate:openapi"],
      "inputs": ["$TURBO_DEFAULT$", "../../apps/api/openapi/openapi.json"],
      "outputs": ["src/gen/**"],
      "env": ["NODE_ENV"]
    },
    "@repo/cli#generate": {
      "dependsOn": ["@repo/core#generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../apps/api/openapi/openapi.json",
        "scripts/generate-cli.mjs"
      ],
      "outputs": ["src/gen/**"],
      "env": ["NODE_ENV"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".react-email/**"],
      "env": [
        "NODE_ENV",
        "JWT_SECRET",
        "AI_PROVIDER",
        "ANTHROPIC_API_KEY",
        "OLLAMA_BASE_URL",
        "OPEN_ROUTER_API_KEY",
        "DATABASE_URL",
        "PGLITE",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_GIT_COMMIT_REF",
        "AUTH_COOKIE_NAME",
        "NEXT_PUBLIC_AUTH_COOKIE_NAME",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_AUTH_TOKEN"
      ]
    },
    "lint": {},
    "lint:eslint": {
      "env": [
        "EXPO_OS",
        "EXPO_PUBLIC_API_URL",
        "AUTH_COOKIE_NAME",
        "AI_DEFAULT_MODEL",
        "AI_PROVIDER",
        "ANTHROPIC_API_KEY",
        "NEWSAPI_KEY",
        "NODE_ENV",
        "CI",
        "DATABASE_URL",
        "PGLITE",
        "RUN_PG_MIGRATE",
        "OLLAMA_BASE_URL",
        "OPEN_ROUTER_API_KEY",
        "VITEST",
        "LOG_ENABLED",
        "LOG_LEVEL",
        "LOG_SERVICE",
        "VERCEL",
        "VERCEL_GIT_COMMIT_REF",
        "VERCEL_ENV",
        "NEXT_PUBLIC_AUTH_COOKIE_NAME",
        "NEXT_PUBLIC_LOG_ENABLED",
        "NEXT_PUBLIC_LOG_LEVEL",
        "PLAYWRIGHT_API_URL",
        "PLAYWRIGHT_APP_URL",
        "VERCEL_AUTOMATION_BYPASS_SECRET",
        "NEXT_RUNTIME",
        "APP_URL",
        "EMAIL_ASSETS_URL",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_ENVIRONMENT",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_AUTH_TOKEN",
        "WEBAUTHN_RP_NAME",
        "TOTP_ISSUER",
        "RATE_LIMIT_MAX",
        "TEST_LOG_LEVEL"
      ]
    },
    "lint:eslint:fix": {
      "cache": false,
      "env": [
        "EXPO_OS",
        "EXPO_PUBLIC_API_URL",
        "AUTH_COOKIE_NAME",
        "AI_PROVIDER",
        "ANTHROPIC_API_KEY",
        "NEWSAPI_KEY",
        "NODE_ENV",
        "CI",
        "DATABASE_URL",
        "PGLITE",
        "RUN_PG_MIGRATE",
        "OLLAMA_BASE_URL",
        "OPEN_ROUTER_API_KEY",
        "AI_DEFAULT_MODEL",
        "VITEST",
        "LOG_ENABLED",
        "LOG_LEVEL",
        "LOG_SERVICE",
        "VERCEL",
        "VERCEL_GIT_COMMIT_REF",
        "VERCEL_ENV",
        "NEXT_PUBLIC_AUTH_COOKIE_NAME",
        "NEXT_PUBLIC_LOG_ENABLED",
        "NEXT_PUBLIC_LOG_LEVEL",
        "PLAYWRIGHT_API_URL",
        "PLAYWRIGHT_APP_URL",
        "VERCEL_AUTOMATION_BYPASS_SECRET",
        "NEXT_RUNTIME",
        "APP_URL",
        "EMAIL_ASSETS_URL",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_ENVIRONMENT",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_AUTH_TOKEN",
        "WEBAUTHN_RP_NAME",
        "TOTP_ISSUER",
        "RATE_LIMIT_MAX",
        "TEST_LOG_LEVEL"
      ]
    },
    "checktypes": { "env": ["NODE_ENV"] },
    "test": {
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "PGLITE",
        "RUN_PG_MIGRATE",
        "AI_DEFAULT_MODEL",
        "AI_PROVIDER",
        "ANTHROPIC_API_KEY",
        "OLLAMA_BASE_URL",
        "OPEN_ROUTER_API_KEY",
        "CI",
        "VITEST_WORKER_ID",
        "ALLOW_TEST",
        "VITEST",
        "AUTH_COOKIE_NAME",
        "NEXT_PUBLIC_AUTH_COOKIE_NAME"
      ]
    },
    "@repo/web#test": {
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "PGLITE",
        "RUN_PG_MIGRATE",
        "AI_DEFAULT_MODEL",
        "AI_PROVIDER",
        "ANTHROPIC_API_KEY",
        "OLLAMA_BASE_URL",
        "OPEN_ROUTER_API_KEY",
        "CI",
        "VITEST_WORKER_ID",
        "ALLOW_TEST",
        "VITEST",
        "AUTH_COOKIE_NAME",
        "NEXT_PUBLIC_AUTH_COOKIE_NAME"
      ]
    },
    "test:unit": {
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "PGLITE",
        "RUN_PG_MIGRATE",
        "AI_DEFAULT_MODEL",
        "AI_PROVIDER",
        "ANTHROPIC_API_KEY",
        "OLLAMA_BASE_URL",
        "OPEN_ROUTER_API_KEY",
        "CI",
        "VITEST_WORKER_ID",
        "ALLOW_TEST",
        "VITEST",
        "AUTH_COOKIE_NAME",
        "NEXT_PUBLIC_AUTH_COOKIE_NAME",
        "WEBAUTHN_RP_NAME",
        "TOTP_ISSUER",
        "RATE_LIMIT_MAX"
      ]
    },
    "test:e2e": {
      "env": [
        "NODE_ENV",
        "CI",
        "PORT",
        "HOST",
        "DATABASE_URL",
        "PGLITE",
        "RUN_PG_MIGRATE",
        "AI_DEFAULT_MODEL",
        "AI_PROVIDER",
        "ANTHROPIC_API_KEY",
        "OLLAMA_BASE_URL",
        "OPEN_ROUTER_API_KEY",
        "NEXT_PUBLIC_API_URL",
        "PLAYWRIGHT_REUSE_SERVER",
        "JWT_SECRET",
        "PLAYWRIGHT_APP_URL",
        "PLAYWRIGHT_API_URL",
        "VERCEL_AUTOMATION_BYPASS_SECRET",
        "AUTH_COOKIE_NAME",
        "NEXT_PUBLIC_AUTH_COOKIE_NAME"
      ]
    },
    "dev": {
      "dependsOn": [],
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "PORT",
        "HOST",
        "DATABASE_URL",
        "PGLITE",
        "RUN_PG_MIGRATE",
        "AI_PROVIDER",
        "ANTHROPIC_API_KEY",
        "OLLAMA_BASE_URL",
        "OPEN_ROUTER_API_KEY",
        "NEXT_PUBLIC_API_URL",
        "AUTH_COOKIE_NAME",
        "NEXT_PUBLIC_AUTH_COOKIE_NAME"
      ]
    }
  }
}
