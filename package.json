{
  "name": "basilic",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "qa": "node scripts/run-qa.mjs",
    "checktypes": "turbo checktypes",
    "format": "biome format . --write",
    "lint": "pnpm lint:biome && pnpm lint:eslint",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check . --write",
    "lint:eslint": "turbo run lint:eslint",
    "lint:eslint:fix": "turbo run lint:eslint:fix",
    "lint:fix": "pnpm lint:eslint:fix && pnpm lint:biome:fix",
    "test": "turbo run test",
    "test:e2e": "node scripts/run-e2e.mjs",
    "hooks:pre-commit": "pnpm hooks:security && biome check --write --staged --no-errors-on-unmatched && git update-index --again",
    "hooks:security": "pnpm security:block-files && pnpm security:secrets && pnpm security:osv",
    "security:block-files": "node scripts/block-secret-files.mjs",
    "security:secrets": "node scripts/scan-secrets-staged.mjs",
    "security:secrets:full": "gitleaks detect --redact --verbose --config .gitleaks.toml",
    "security:osv": "node scripts/scan-osv.mjs",
    "security:audit": "pnpm audit --audit-level=high",
    "security:check": "node scripts/security-check.mjs",
    "security:deepsec:scan": "pnpm --dir .deepsec deepsec scan",
    "security:deepsec:process": "pnpm --dir .deepsec deepsec process --agent codex --model gpt-5.6-sol --thinking-level medium",
    "security:deepsec:process:diff": "pnpm --dir .deepsec deepsec process --agent codex --model gpt-5.6-sol --thinking-level medium --diff origin/main",
    "security:deepsec:process:diff:grok": "pnpm --dir .deepsec deepsec process --agent pi --model xai/grok-4.6 --thinking-level medium --diff origin/main",
    "security:deepsec:report": "pnpm --dir .deepsec deepsec report",
    "postinstall": "npx simple-git-hooks",
    "setup": "pnpm i && npx simple-git-hooks && pnpm setup:gitleaks && pnpm setup:osv && pnpm setup:database && pnpm setup:deepsec",
    "setup:gitleaks": "node scripts/setup-gitleaks.mjs",
    "setup:osv": "node scripts/setup-osv-scanner.mjs",
    "setup:database": "node scripts/setup-database.mjs",
    "setup:deepsec": "pnpm --dir .deepsec install --frozen-lockfile",
    "reset": "pnpm --filter @repo/api reset",
    "update-deps": "pnpm self-update && pnpm update --latest --recursive"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "~24.13.3",
    "@types/react": "^19.2.18",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "ahooks": "^3.9.7",
    "eslint": "^10.9.1",
    "simple-git-hooks": "2.14.0",
    "tsup": "^8.5.1",
    "turbo": "^2.10.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vercel": "latest",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.24.0",
  "simple-git-hooks": {
    "pre-commit": "pnpm hooks:pre-commit"
  }
}
