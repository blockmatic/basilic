{
  "name": "basilic",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check . --write",
    "lint:eslint": "turbo run lint:eslint",
    "lint:eslint:fix": "turbo run lint:eslint:fix",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run lint:biome:fix",
    "format": "biome format . --write",
    "hooks:pre-commit": "biome check --write --staged --no-errors-on-unmatched && git update-index --again",
    "setup": "echo 'Setup script pending'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@basilic/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "simple-git-hooks": "2.13.1",
    "turbo": "^2.7.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "simple-git-hooks": {
    "pre-commit": "bun run hooks:pre-commit"
  }
}
