{
  "name": "basilic",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo dev",
    "checktypes": "turbo checktypes",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check . --write",
    "lint:eslint": "turbo run lint:eslint",
    "lint:eslint:fix": "turbo run lint:eslint:fix",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run lint:biome:fix",
    "format": "biome format . --write",
    "hooks:pre-commit": "pnpm run hooks:security && biome check --write --staged --no-errors-on-unmatched && git update-index --again",
    "hooks:security": "node scripts/block-secret-files.mjs && node scripts/scan-secrets-staged.mjs",
    "secrets:scan:staged": "gitleaks protect --staged --redact --verbose --config .gitleaks.toml",
    "secrets:scan": "gitleaks detect --redact --verbose --config .gitleaks.toml",
    "deps:osv": "osv-scanner scan --lockfile=pnpm-lock.yaml",
    "deps:audit": "pnpm audit --audit-level=moderate",
    "postinstall": "npx simple-git-hooks",
    "setup": "pnpm install && npx simple-git-hooks && node scripts/setup-security-tools.mjs",
    "qa": "pnpm i && pnpm lint:fix && pnpm checktypes && pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@basilic/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "simple-git-hooks": "2.13.1",
    "turbo": "^2.7.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "simple-git-hooks": {
    "pre-commit": "pnpm run hooks:pre-commit"
  }
}
