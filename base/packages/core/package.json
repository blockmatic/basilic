{
  "name": "@repo/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "node -e \"process.exit(0)\"",
    "checktypes": "tsc --noEmit",
    "dev": "node --import tsx scripts/wait-and-watch.mjs",
    "prepack": "tsup && tsc --declaration --emitDeclarationOnly && node ../../scripts/prepare-publish.mjs",
    "postpack": "node ../../scripts/restore-publish.mjs",
    "generate": "openapi-ts && node --import tsx scripts/generate-wrapper.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@repo/typescript-config": "workspace:*",
    "@repo/utils": "workspace:*",
    "@typescript/native": "npm:typescript@^7.0.2",
    "chokidar-cli": "^3.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1"
  }
}
